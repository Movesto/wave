# wave configuration -- copy this file to ".env" (right next to it) and fill in the values:
#     cp .env.example .env        (Windows:  copy .env.example .env)
#
# Format is KEY=value, one per line. Keep the WAVE_ prefix EXACTLY -- other names
# (e.g. OPENROUTER_API_KEY) are ignored. Lines starting with # are comments.
# wave loads, in order (first value wins): ~/.wave/config, this repo's .env, then ./.env
# in your current directory. Or just run `wave` -> /setup to fill this in interactively.

# --- Provider endpoint (any OpenAI-compatible API) ---
# Cloud (stronger reasoning; sends code off-box) -- OpenRouter shown:
WAVE_API_BASE=https://openrouter.ai/api/v1
# ...or LOCAL + private via ollama (no egress):
# WAVE_API_BASE=http://localhost:11434/v1

# --- API key for that provider (leave blank / omit for a local ollama server) ---
WAVE_API_KEY=sk-or-...your-provider-key...

# --- FIRST model: the primary reasoner that finds, proves, and patches ---
WAVE_MODEL=deepseek/deepseek-v4-flash-0731

# --- SECOND model: a DIFFERENT model that independently audits the judgment-call findings
#     (IDOR / business logic / un-marked effects). Recommended for cloud runs -- two
#     independent models must agree before such a finding stands. Blank = reuse the first. ---
WAVE_AUDIT_MODEL=z-ai/glm-5.3-flash

# --- Optional ---
# WAVE_NO_THINK=1        # disable a Qwen3-family model's <think> phase (answer-only)
# WAVE_NUM_CTX=16384     # context window for a local ollama server
